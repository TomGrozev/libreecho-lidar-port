diff --git a/tests/test_bluetooth_discoverable_contract.sh b/tests/test_bluetooth_discoverable_contract.sh
new file mode 100755
index 0000000..2a9fa5b
--- /dev/null
+++ b/tests/test_bluetooth_discoverable_contract.sh
@@ -0,0 +1,37 @@
+#!/bin/sh
+set -eu
+
+# Regression contract: the kernel rejects MGMT_OP_SET_DISCOVERABLE with
+# MGMT_STATUS_REJECTED while HCI_CONNECTABLE is clear, for either value of the
+# request (net/bluetooth/mgmt.c). btd's standalone visibility toggle therefore
+# has to accept connections first, and a disable while not connectable is
+# already satisfied. This source-level check is host-verifiable; the physical
+# pairing remains separate.
+python3 - <<'PY'
+from pathlib import Path
+
+source = Path('src/adapter/btd.c').read_text()
+start = source.index('if (!strcmp(command, "set_connectable") || !strcmp(command, "set_discoverable")) {')
+end = source.index('return le_adapter_respond_err(response, response_size, id, "unknown command");', start)
+block = source[start:end]
+
+assert 'int discoverable = !strcmp(command, "set_discoverable");' in block
+assert '!(context->current_settings & MGMT_SETTING_CONNECTABLE)' in block
+connect = block.index('set_controller_setting(context, MGMT_OP_SET_CONNECTABLE, 1)')
+visible = block.index('set_controller_setting(context, opcode, enabled)')
+assert connect < visible, (
+    'the adapter must accept connections before it is made discoverable, '
+    'otherwise the kernel rejects the request'
+)
+assert 'controller_command(context, opcode' not in block
+assert '"{\\"changed\\":false}"' in block
+
+mock = Path('src/backend_mock.c').read_text()
+mock_discoverable = mock[mock.index('static int bluetooth_discoverable_mock'):]
+mock_discoverable = mock_discoverable[:mock_discoverable.index('\n')]
+assert 'if(enabled)M(b)->bluetooth.connectable=1;' in mock_discoverable
+mock_connectable = mock[mock.index('static int bluetooth_connectable_mock'):]
+mock_connectable = mock_connectable[:mock_connectable.index('\n')]
+assert 'if(!enabled)M(b)->bluetooth.discoverable=0;' in mock_connectable
+PY
+printf '%s\n' 'bluetooth discoverable contract: ok'
