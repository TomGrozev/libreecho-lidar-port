--- rd-old/etc/init.d/libreecho-mdnsd.init	1970-01-01 10:00:00.000000000 +1000
+++ rd-new/etc/init.d/libreecho-mdnsd.init	1970-01-01 10:00:00.000000000 +1000
@@ -111,7 +111,10 @@
 supervisor_pids() {
     # Every live process running the UI supervisor executable. Matched on
     # /proc/<pid>/exe, never argv or a pidfile, so an unrelated process cannot
-    # be selected.
+    # be selected. A supervisor whose binary was replaced on disk while it
+    # runs (a hot-staged or restored file) reads as "<path> (deleted)"; it is
+    # still the supervisor, and missing it let stop report success while it
+    # kept running and respawning its pair.
     [ -n "$SUPERVISOR" ] || return 0
     want=$($BB readlink -f "$SUPERVISOR" 2>/dev/null) || return 0
     [ -n "$want" ] || return 0
@@ -119,7 +122,10 @@
         [ -d "$entry" ] || continue
         pid=${entry##*/}
         [ "$pid" = "$$" ] && continue
-        [ "$(process_exe "$pid")" = "$want" ] && printf '%s\n' "$pid"
+        exe=$(process_exe "$pid")
+        if [ "$exe" = "$want" ] || [ "$exe" = "$want (deleted)" ]; then
+            printf '%s\n' "$pid"
+        fi
     done
 }
 
@@ -231,7 +237,17 @@
 }
 
 start_supervisor() {
-    "$SUPERVISOR" >>"$LOG" 2>&1 &
+    # A plain background job stays in the session and process group of the
+    # shell that ran restart. When that shell exits the supervisor takes the
+    # hangup with it, and dbus/avahi follow via PDEATHSIG. setsid moves it into
+    # its own session; stdin is /dev/null so it holds nothing from the caller.
+    if command -v setsid >/dev/null 2>&1; then
+        setsid "$SUPERVISOR" </dev/null >>"$LOG" 2>&1 &
+    else
+        # No setsid applet on this image: at least ignore SIGHUP. This does
+        # not leave the session, so it only helps when the hangup is the cause.
+        $BB sh -c 'trap "" HUP; exec "$@"' sh "$SUPERVISOR" </dev/null >>"$LOG" 2>&1 &
+    fi
     supervisor_pid=$!
     count=0
     while [ "$count" -lt "$START_TIMEOUT" ]; do
