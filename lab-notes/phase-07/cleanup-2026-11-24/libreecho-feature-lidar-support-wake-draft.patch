+def layernorm_layers(graph):
+    """Return the input tensor of every LayerNorm-style block in the graph.
+
+    LayerNorm exports as Sub(x, ReduceMean(x)) followed by nodes that square
+    the difference and reduce it to a variance. Matching that Sub/ReduceMean
+    pair is enough to prove the block takes per-sample statistics.
+    """
+    producers = {}
+    for node in graph.node:
+        for output in node.output:
+            producers[output] = node
+    layers = []
+    for node in graph.node:
+        if node.op_type != "Sub" or len(node.input) < 2:
+            continue
+        tensor, mean_name = node.input[0], node.input[1]
+        mean = producers.get(mean_name)
+        if (mean is not None and mean.op_type == "ReduceMean"
+                and mean.input[:1] == [tensor] and tensor not in layers):
+            layers.append(tensor)
+    return layers
+
+
+def _rename_tensor(graph, old, new):
+    if old == new:
+        return
+    for value in list(graph.input) + list(graph.output) + list(graph.value_info):
+        if value.name == old:
+            value.name = new
+    for node in graph.node:
+        for index, name in enumerate(node.input):
+            if name == old:
+                node.input[index] = new
+        for index, name in enumerate(node.output):
+            if name == old:
+                node.output[index] = new
+
+
+def convert_classifier(source, dest, force=False):
+    """Rename a classifier to the device I/O names and validate the result.
+
+    LayerNorm blocks are refused rather than approximated. The normalisation
+    divides by sqrt(var + eps) where var is computed from the current 16x96
+    feature block; that scale changes with every block, so no fixed Gemm
+    weight can reproduce it. An exact fold would require the centred input to
+    be constant, which makes the whole classifier constant and is not a wake
+    word. Refusing keeps a silent score shift off the device.
+    """
+    _require(os.path.isfile(source) and not os.path.islink(source),
+             "classifier must be a regular file: %s" % source)
+    _require(not os.path.lexists(dest) or force,
+             "%s already exists; pass --force to replace it" % dest)
+    model = onnx.load(source, load_external_data=False)
+    graph = model.graph
+    _require(len(graph.input) == 1 and len(graph.output) == 1,
+             "classifier must have exactly one input and one output, found %d and %d"
+             % (len(graph.input), len(graph.output)))
+    external = [t.name for t in graph.initializer
+                if t.data_location == onnx.TensorProto.EXTERNAL]
+    _require(not external,
+             "classifier keeps weights in external data; export one self-contained file")
+
+    ops = sorted({node.op_type for node in graph.node})
+    unsupported = [op for op in ops if op not in CLASSIFIER_OPS]
+    layers = layernorm_layers(graph)
+    if layers:
+        raise CheckError(
+            "classifier has %d LayerNorm block(s) (normalising %s); the device "
+            "cannot run them and they are not foldable into the neighbouring "
+            "Gemm weights: the mean and standard deviation are computed from "
+            "each incoming feature block, so the 1/sqrt(var) scale differs per "
+            "block and fixed weights cannot reproduce it. Train and export the "
+            "model without LayerNorm. Operators outside the device set: %s."
+            % (len(layers), ", ".join(layers), unsupported or "none"))
+    _require(not unsupported,
+             "classifier uses operators %s outside the device set %s; export it "
+             "with the stock layer types before converting"
+             % (unsupported, sorted(CLASSIFIER_OPS)))
+
+    value = graph.input[0]
+    _require(value.type.tensor_type.elem_type == onnx.TensorProto.FLOAT,
+             "classifier input must be float32")
+    shape = [dim.dim_value for dim in value.type.tensor_type.shape.dim]
+    _require(shape == [1, FEATURE_FRAMES, FEATURE_BINS],
+             "classifier input must be [1, %d, %d] before renaming, found %s"
+             % (FEATURE_FRAMES, FEATURE_BINS, shape))
+
+    renamed = [[old, new] for old, new in
+               [(graph.input[0].name, CLASSIFIER_INPUT),
+                (graph.output[0].name, CLASSIFIER_OUTPUT)] if old != new]
+    _rename_tensor(graph, graph.input[0].name, CLASSIFIER_INPUT)
+    _rename_tensor(graph, graph.output[0].name, CLASSIFIER_OUTPUT)
+
+    # Only default-domain ops survive the allowlist check above, so unused
+    # imports (for example ai.onnx.ml left by a TF export) can be dropped.
+    kept = [opset for opset in model.opset_import if opset.domain in ("", "ai.onnx")]
+    _require(kept, "classifier imports no default ONNX opset")
+    del model.opset_import[:]
+    model.opset_import.extend(kept)
+    for opset in kept:
+        if opset.version > 13:
+            opset.version = 13
+
+    onnx.checker.check_model(model)
+    directory = os.path.dirname(os.path.abspath(dest))
+    os.makedirs(directory, exist_ok=True)
+    handle, staging = tempfile.mkstemp(dir=directory, prefix=".convert-", suffix=".onnx")
+    os.close(handle)
+    try:
+        onnx.save(model, staging)
+        check_classifier(staging)
+        os.replace(staging, dest)
+    except BaseException:
+        if os.path.exists(staging):
+            os.remove(staging)
+        raise
+
+    return {
+        "output": dest,
+        "renamed": renamed,
+        "operators": ops,
+        "opset": ["%s:%s" % (opset.domain or "ai.onnx", opset.version)
+                  for opset in model.opset_import],
+        "max_abs_diff": max_output_difference(source, dest),
+    }
+
+
+def max_output_difference(reference, candidate, samples=8, seed=0):
+    """Largest absolute output difference between two graphs on random inputs."""
+    original = ort.InferenceSession(reference, providers=PROVIDERS)
+    converted = ort.InferenceSession(candidate, providers=PROVIDERS)
+    _require(len(original.get_inputs()) == 1 and len(converted.get_inputs()) == 1,
+             "both graphs must have exactly one input")
+    ref_shape = list(original.get_inputs()[0].shape)
+    new_shape = list(converted.get_inputs()[0].shape)
+    _require(ref_shape == new_shape,
+             "input shapes differ: %s vs %s" % (ref_shape, new_shape))
+    rng = np.random.default_rng(seed)
+    worst = 0.0
+    for _ in range(samples):
+        x = rng.standard_normal(ref_shape).astype(np.float32)
+        left = original.run(None, {original.get_inputs()[0].name: x})
+        right = converted.run(None, {converted.get_inputs()[0].name: x})
+        _require(len(left) == len(right), "output counts differ")
+        for a, b in zip(left, right):
+            a = np.asarray(a, np.float64)
+            b = np.asarray(b, np.float64)
+            _require(a.shape == b.shape, "output shapes differ: %s vs %s" % (a.shape, b.shape))
+            if a.size:
+                worst = max(worst, float(np.max(np.abs(a - b))))
+    return worst
+
