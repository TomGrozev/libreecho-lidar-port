+def make_layernorm_classifier(path):
+    """Write a classifier shaped like openWakeWord v0.5.1: Gemm then LayerNorm."""
+    rng = np.random.RandomState(1)
+    arrays = {
+        "W1": rng.randn(128, 16 * 96).astype(np.float32),
+        "B1": np.zeros(128, np.float32),
+        "G": np.ones(128, np.float32),
+        "B2": np.zeros(128, np.float32),
+        "W2": rng.randn(1, 128).astype(np.float32),
+        "B3": np.zeros(1, np.float32),
+        "eps": np.asarray(1e-5, np.float32),
+    }
+    nodes = [
+        helper.make_node("Flatten", ["x.1"], ["flat"], axis=1),
+        helper.make_node("Gemm", ["flat", "W1", "B1"], ["hidden"]),
+        helper.make_node("ReduceMean", ["hidden"], ["mean"], axes=[-1]),
+        helper.make_node("Sub", ["hidden", "mean"], ["centered"]),
+        helper.make_node("Mul", ["centered", "centered"], ["squared"]),
+        helper.make_node("ReduceMean", ["squared"], ["var"], axes=[-1]),
+        helper.make_node("Add", ["var", "eps"], ["var_eps"]),
+        helper.make_node("Sqrt", ["var_eps"], ["std"]),
+        helper.make_node("Div", ["centered", "std"], ["norm"]),
+        helper.make_node("Mul", ["norm", "G"], ["scaled"]),
+        helper.make_node("Add", ["scaled", "B2"], ["normed"]),
+        helper.make_node("Relu", ["normed"], ["act"]),
+        helper.make_node("Gemm", ["act", "W2", "B3"], ["logit"]),
+        helper.make_node("Sigmoid", ["logit"], ["53"]),
+    ]
+    graph = helper.make_graph(
+        nodes, "layernorm-classifier",
+        [helper.make_tensor_value_info("x.1", TensorProto.FLOAT, [1, 16, 96])],
+        [helper.make_tensor_value_info("53", TensorProto.FLOAT, [1, 1])],
+        initializer=[numpy_helper.from_array(value, name) for name, value in arrays.items()])
+    model = helper.make_model(graph, opset_imports=[helper.make_opsetid("", 13)])
+    model.ir_version = 7
+    onnx.checker.check_model(model)
+    onnx.save(model, path)
+    return path
+
