diff --git a/arch/arm64/kernel/head.S b/arch/arm64/kernel/head.S
index cdbbc95eb49d..51871d81dfb4 100644
--- a/arch/arm64/kernel/head.S
+++ b/arch/arm64/kernel/head.S
@@ -86,6 +86,87 @@
 	 *  x28        create_idmap()                           callee preserved temp register
 	 */
 SYM_CODE_START(primary_entry)
+#ifdef CONFIG_LIBREECHO_LATEINIT_FASTBOOT
+	/*
+	 * [LIBREECHO-PROBE] Earliest marker: MMU is still off (only
+	 * __primary_switch enables it) and only x0..x3 carry boot state, so
+	 * x9..x11 are free.  With the MMU off, data accesses are
+	 * Device-nGnRnE, so the store reaches the PoC without cache
+	 * maintenance.  Writes 16 bytes "PROBE-ENTRY!" plus four NULs to
+	 * two reserved regions: 0x43860700 in ramoops' pmsg zone and
+	 * 0x43ff0800 in the entry-probe reservation.
+	 *
+	 * The second address answers a question the first cannot, and it
+	 * must be readable by LK's fastboot.  The entry-probe page
+	 * 0x43ff0000..0x43ffffff ends at the stock ramdisk load address
+	 * and sits inside LK's boot-image mapping (0x40080000..0x4407ffff),
+	 * so a fastboot fetch of it is a mapped read rather than a fault.
+	 * The ramoops window is owned by this kernel, which can clear or
+	 * rewrite it during pstore init, while the no-map reserved page
+	 * stays untouched.  A surviving 0x43ff0800 marker with a missing
+	 * 0x43860700 marker means the handover reached primary_entry and
+	 * the ramoops window was lost afterwards; both missing means the
+	 * handover itself never ran (or the wrong slot booted).
+	 * Remove with the rest of LIBREECHO-PROBE.
+	 */
+	movz	w9, #0x0700
+	movk	w9, #0x4386, lsl #16
+	movz	x10, #0x5250			// "PROBE-EN"
+	movk	x10, #0x424f, lsl #16
+	movk	x10, #0x2d45, lsl #32
+	movk	x10, #0x4e45, lsl #48
+	movz	x11, #0x5254			// "TRY!" + 4 NUL
+	movk	x11, #0x2159, lsl #16
+	stp	x10, x11, [x9]
+	movz	w9, #0x0800
+	movk	w9, #0x43ff, lsl #16
+	stp	x10, x11, [x9]
+#ifdef CONFIG_LIBREECHO_ENTRY_WDT_RESET
+	/*
+	 * [LIBREECHO-PROBE] One-shot delayed-watchdog reset, immediately
+	 * after both marker stores.  The MMU is still off and x12..x15 are
+	 * free here.  Wait five seconds on the generic counter so LK's
+	 * fastboot can fetch the marker pages, then reset through TOPRGU
+	 * with the bootchain's proven sequence.
+	 *
+	 * This is the matched control for the late-init probe: a warm reset
+	 * never powers DRAM, so a marker lost by a late_initcall reset is
+	 * indistinguishable from a handover that never ran.  Resetting here,
+	 * before preserve_boot_args and before any kernel code executes,
+	 * leaves no kernel execution between the stores and the reset that
+	 * could lose the marker, so absence of a marker is evidence about
+	 * primary_entry itself rather than about warm-reset RAM retention.
+	 *
+	 * The watchdog is deliberately not disabled or reprogrammed first.
+	 * Remove with the rest of LIBREECHO-PROBE.
+	 */
+	mrs	x12, cntfrq_el0
+	movz	x13, #5
+	mul	x12, x12, x13
+	mrs	x14, cntpct_el0
+	add	x12, x12, x14
+1:
+	mrs	x14, cntpct_el0
+	cmp	x14, x12
+	b.lo	1b
+
+	movz	w12, #0x7000
+	movk	w12, #0x1000, lsl #16		// TOPRGU base 0x10007000
+	movz	w13, #0x1971
+	str	w13, [x12, #0x08]		// WDT kick key
+	ldr	w13, [x12, #0x24]		// WDT_NONRST
+	orr	w13, w13, #4
+	str	w13, [x12, #0x24]
+	movz	w13, #0x0014
+	movk	w13, #0x2200, lsl #16
+	str	w13, [x12, #0x00]		// mode: reset to fastboot
+	dsb	sy
+	movz	w13, #0x1209
+	str	w13, [x12, #0x14]		// SWRST
+2:
+	b	2b
+#endif
+#endif
 	bl	preserve_boot_args
 	bl	init_kernel_el			// w0=cpu_boot_mode
 	mov	x20, x0
diff --git a/arch/arm64/kernel/setup.c b/arch/arm64/kernel/setup.c
index 44c4d79bd914..ad6a587d445d 100644
--- a/arch/arm64/kernel/setup.c
+++ b/arch/arm64/kernel/setup.c
@@ -333,8 +333,37 @@ void __init __no_sanitize_address setup_arch(char **cmdline_p)
 
 	arm64_memblock_init();
 
+#ifdef CONFIG_LIBREECHO_LATEINIT_FASTBOOT
+	/*
+	 * [LIBREECHO-PROBE] Reserve the pmsg marker page before paging_init()
+	 * maps RAM and before mm_init() can free it to the page allocator, so
+	 * the markers at 0x43860000 survive until the late readback.  Removal
+	 * and the full probe layout are documented in init/main.c.
+	 */
+	memblock_reserve(0x43860000UL, 0x1000UL);
+#endif
+
 	paging_init();
 
+#ifdef CONFIG_LIBREECHO_LATEINIT_FASTBOOT
+	/*
+	 * [LIBREECHO-PROBE] Earliest point where phys_to_virt is valid: only
+	 * arm64_memblock_init() fixes memstart_addr/PHYS_OFFSET and only
+	 * paging_init() installs the final linear map covering 0x43860000.
+	 * Slot 0x500, tag 18 bytes plus NUL, clear of the 0x000/0x100 driver
+	 * slots and the 0x200/0x300/0x400 init/main.c slots.
+	 */
+	{
+		void *probe = phys_to_virt(0x43860000UL + 0x500);
+
+		memcpy(probe, "PROBE-PAGING-INIT!",
+		       sizeof("PROBE-PAGING-INIT!"));
+		dcache_clean_poc((unsigned long)probe,
+				 (unsigned long)probe +
+				 sizeof("PROBE-PAGING-INIT!"));
+	}
+#endif
+
 	acpi_table_upgrade();
 
 	/* Parse the ACPI tables for possible boot-time configuration */
diff --git a/arch/arm64/mm/mmu.c b/arch/arm64/mm/mmu.c
index 72fb70f2bfb2..870caed88506 100644
--- a/arch/arm64/mm/mmu.c
+++ b/arch/arm64/mm/mmu.c
@@ -865,6 +865,26 @@ void __init paging_init(void)
 	pgd_clear_fixmap();
 
 	cpu_replace_ttbr1(lm_alias(swapper_pg_dir), init_idmap_pg_dir);
+
+#ifdef CONFIG_LIBREECHO_LATEINIT_FASTBOOT
+	/*
+	 * [LIBREECHO-PROBE] First point where the new linear map is live.
+	 * map_mem() only fills swapper_pg_dir through the pgd fixmap; TTBR1
+	 * still walks init_pg_dir until cpu_replace_ttbr1() above returns, so
+	 * a phys_to_virt write right after map_mem() would fault or land in
+	 * the early mapping.  Slot 0x600, 14 bytes plus NUL, clear of the
+	 * driver slots 0x000/0x100 and the 0x200/0x300/0x400/0x500 slots.
+	 */
+	{
+		void *probe = phys_to_virt(0x43860000UL + 0x600);
+
+		memcpy(probe, "PROBE-MAP-MEM!", sizeof("PROBE-MAP-MEM!"));
+		dcache_clean_poc((unsigned long)probe,
+				 (unsigned long)probe +
+				 sizeof("PROBE-MAP-MEM!"));
+	}
+#endif
+
 	init_mm.pgd = swapper_pg_dir;
 
 	memblock_phys_free(__pa_symbol(init_pg_dir),
diff --git a/drivers/misc/Kconfig b/drivers/misc/Kconfig
index fb62e4ecbeee..8824803471b8 100644
--- a/drivers/misc/Kconfig
+++ b/drivers/misc/Kconfig
@@ -508,6 +508,193 @@ config AMZ_PRIVACY
 	  lights the mute button's lamp from a software mute without
 	  entering the privacy latch.
 
+config LIBREECHO_PSTORE_PANIC_PROBE
+	bool "Force a panic at late_initcall_sync for pstore diagnostics"
+	depends on PSTORE
+	default n
+	help
+	  Diagnostic-only driver for LibreEcho. At late_initcall_sync, after
+	  the ordinary late_initcall pstore and pstore_blk registration, it
+	  emits one tagged emergency log line and panics with a unique
+	  message so the pstore backend can capture the full kernel log.
+
+	  This deliberately crashes the kernel on every boot. Say N unless
+	  you are building a one-shot pstore capture image.
+
+config LIBREECHO_LATEINIT_FASTBOOT
+	bool "Return the MT8167 to fastboot from late_initcall_sync"
+	depends on ARM64 && ARCH_MEDIATEK && HAS_IOMEM
+	default n
+	help
+	  Diagnostic-only driver for LibreEcho. At late_initcall_sync it writes
+	  the marker LIBREECHOLATEINIT! to physical 0x4df00000 at the top of
+	  LK's mapped download window, then arms the MT8167 TOPRGU watchdog to
+	  reset the CPU into Kaeru fastboot: kick key 0x1971 at +0x08, set bit
+	  2 of WDT_NONRST at +0x24, write 0x22000014 to the mode register at
+	  +0x00, dsb, then SWRST key 0x1209 at +0x14. It never returns.
+
+	  The fastboot device appearing after the reboot is the intended
+	  observation; the RAM marker is only a secondary check. This resets
+	  the device on every boot. Say N unless you are building a one-shot
+	  late-init reachability image.
+
+config LIBREECHO_ENTRY_WDT_RESET
+	bool "Reset from primary_entry after a five-second delayed watchdog kick"
+	depends on LIBREECHO_LATEINIT_FASTBOOT
+	default n
+	help
+	  One-shot diagnostic for LibreEcho. Inside the primary_entry entry
+	  marker block, after both RAM markers are stored and while the MMU is
+	  still off, this waits five seconds on the generic counter
+	  (CNTFRQ_EL0/CNTPCT_EL0) and then resets the MT8167 through TOPRGU
+	  with the bootchain's proven sequence: kick key 0x1971 at +0x08, set
+	  bit 2 of WDT_NONRST at +0x24, write 0x22000014 to the mode register
+	  at +0x00, dsb, then SWRST key 0x1209 at +0x14. It never returns, so
+	  preserve_boot_args and the rest of the kernel do not run.
+
+	  The five-second delay is the observation window: LK's fastboot can
+	  fetch the two marker pages before the reset. Because the reset
+	  happens before any kernel code runs, a missing marker cannot be
+	  explained by warm-reset DRAM loss or by a kernel stall; it can only
+	  mean the handover never reached primary_entry. The watchdog is not
+	  disabled or reprogrammed first.
+
+	  This reboots the device five seconds after every boot. Say N unless
+	  you are building a one-shot entry-reachability image.
+
+config LIBREECHO_REST_INIT_WDT_RESET
+	bool "Reset from rest_init after a five-second delayed watchdog kick"
+	depends on LIBREECHO_LATEINIT_FASTBOOT
+	default n
+	help
+	  One-shot diagnostic for LibreEcho. At the very top of rest_init,
+	  before rcu_scheduler_starting() and user_mode_thread(), this waits
+	  five seconds and then resets the MT8167 through TOPRGU with the
+	  bootchain's proven sequence: kick key 0x1971 at +0x08, set bit 2 of
+	  WDT_NONRST at +0x24, write 0x22000014 to the mode register at +0x00,
+	  dsb, then SWRST key 0x1209 at +0x14. It never returns, so the normal
+	  rest_init body and all later init do not run.
+
+	  The fastboot return after the delay is the reachability signal. It
+	  does not depend on RAM surviving the reset, so it reports whether this
+	  stage ran even when marker pages were overwritten on the failure
+	  path. The watchdog is not disabled or reprogrammed first.
+
+	  This reboots the device five seconds after every boot. Say N unless
+	  you are building a one-shot rest_init reachability image.
+
+config LIBREECHO_INITCALL_WDT_RESET
+	int "Reset from do_initcalls at a selected initcall level"
+	depends on LIBREECHO_LATEINIT_FASTBOOT
+	range -2 7
+	default -1
+	help
+	  One-shot diagnostic for LibreEcho. This waits five seconds and then
+	  resets the MT8167 through TOPRGU with the bootchain's proven
+	  sequence inside do_initcalls(), the same mechanism as the
+	  LIBREECHO_REST_INIT_WDT_RESET probe. Because the reset is a
+	  reachability signal that does not depend on RAM surviving, the
+	  fastboot return after the delay reports how far init got.
+
+	  The value selects where in do_initcalls() the reset fires:
+	    -1  disabled (default)
+	    -2  before the first level, after rest_init but before level 0
+	     0  pure
+	     1  core
+	     2  postcore
+	     3  arch
+	     4  subsys
+	     5  fs
+	     6  device
+	     7  late
+	  Levels 0..7 fire immediately after that level's initcalls finish.
+	  When set to 7, the libreecho_lateinit_fastboot_init
+	  late_initcall_sync registration is suppressed so its own reset
+	  cannot mask the after-late-level probe; the reset helper stays
+	  built. The delay keeps LK's fastboot alive long enough for a fetch.
+
+	  This reboots the device five seconds after every boot when set to
+	  -2 or 0..7. Leave it at -1 unless you are building a one-shot
+	  initcall-reachability image.
+
+config LIBREECHO_INITCALL_ITEM_WDT_RESET
+	int "Reset before a selected late-level initcall item"
+	depends on LIBREECHO_LATEINIT_FASTBOOT
+	range -1 1023
+	default -1
+	help
+	  One-shot diagnostic for LibreEcho. Inside do_initcall_level(), this
+	  waits five seconds and then resets the MT8167 through TOPRGU with
+	  the bootchain's proven sequence before running the selected
+	  zero-based item of the late initcall level (level 7).
+
+	  Reaching the reset proves that every earlier late initcall returned.
+	  The value is the zero-based index in the ordered late-level list:
+	    -1    disabled (default)
+	     0    before the first late initcall
+	     N    before the N-th late initcall (0-based)
+	  The delay keeps LK's fastboot alive long enough for a fetch.
+
+	  While this is 0..1023, the libreecho_lateinit_fastboot_init
+	  late_initcall_sync registration is suppressed so its own reset
+	  cannot mask the per-item probe; the reset helper stays built.
+
+	  This reboots the device five seconds after every boot when enabled.
+	  Leave it at -1 unless you are building a one-shot late-item probe.
+
+config LIBREECHO_USERSPACE_WDT_RESET
+	bool "Reset just before userspace init after a five-second delayed watchdog kick"
+	depends on LIBREECHO_LATEINIT_FASTBOOT
+	default n
+	help
+	  One-shot diagnostic for LibreEcho. In kernel_init, after
+	  kernel_init_freeable(), async_synchronize_full(), free_initmem(),
+	  mark_readonly(), pti_finalize() and do_sysctl_args(), and immediately
+	  before the ramdisk_execute_command/run_init_process path, this waits
+	  five seconds and then resets the MT8167 through TOPRGU with the
+	  bootchain's proven sequence: kick key 0x1971 at +0x08, set bit 2 of
+	  WDT_NONRST at +0x24, write 0x22000014 to the mode register at +0x00,
+	  dsb, then SWRST key 0x1209 at +0x14. It never returns, so userspace
+	  init is not executed.
+
+	  The fastboot return after the delay is the reachability signal: it
+	  proves the kernel completed every kernel_init_freeable() step, the
+	  async synchronisation, free_initmem(), the final kernel setup and
+	  do_sysctl_args(), and reached the userspace exec point. While this
+	  option is set, the final libreecho_lateinit_fastboot_init
+	  late_initcall_sync registration is suppressed so its own earlier
+	  reset cannot mask this probe; the reset helper stays built.
+
+	  This reboots the device five seconds after every boot. Say N unless
+	  you are building a one-shot pre-userspace reachability image.
+
+config LIBREECHO_EXEC_SUCCESS_WDT_RESET
+	bool "Reset after a successful ramdisk init exec with a five-second delayed watchdog kick"
+	depends on LIBREECHO_LATEINIT_FASTBOOT
+	default n
+	help
+	  One-shot diagnostic for LibreEcho. In kernel_init, inside the
+	  ramdisk_execute_command branch, this runs only when
+	  run_init_process(ramdisk_execute_command) has returned zero. It waits
+	  five seconds and then resets the MT8167 through TOPRGU with the
+	  bootchain's proven sequence: kick key 0x1971 at +0x08, set bit 2 of
+	  WDT_NONRST at +0x24, write 0x22000014 to the mode register at +0x00,
+	  dsb, then SWRST key 0x1209 at +0x14. It never returns, so userspace
+	  init does not start.
+
+	  kernel_execve returns zero only after the kernel has successfully
+	  loaded the executed file, so the fastboot return after the delay
+	  proves that the stock ramdisk /init was accepted by the kernel exec
+	  path. A failed exec returns an error, skips this probe, and continues
+	  with the ordinary fallback paths. While this option is set, the final
+	  libreecho_lateinit_fastboot_init late_initcall_sync registration is
+	  suppressed so its own earlier reset cannot mask this probe; the reset
+	  helper stays built.
+
+	  This reboots the device five seconds after every boot that successfully
+	  execs the ramdisk init. Say N unless you are building a one-shot init
+	  exec-success image.
+
 source "drivers/misc/c2port/Kconfig"
 source "drivers/misc/eeprom/Kconfig"
 source "drivers/misc/cb710/Kconfig"
