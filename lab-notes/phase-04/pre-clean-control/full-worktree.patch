diff --git a/drivers/usb/musb/Kconfig b/drivers/usb/musb/Kconfig
index 6c8f7763e75e..e1f6c14cb652 100644
--- a/drivers/usb/musb/Kconfig
+++ b/drivers/usb/musb/Kconfig
@@ -123,6 +123,115 @@ config USB_MUSB_MEDIATEK
 	select GENERIC_PHY
 	select USB_ROLE_SWITCH
 
+config LIBREECHO_MUSB_PROBE_STATUS
+	bool "Record MediaTek MUSB probe status for a boot diagnostic"
+	depends on USB_MUSB_MEDIATEK=y
+	default n
+	help
+	  Temporary LibreEcho diagnostic. The MediaTek MUSB glue records how
+	  far its probe got in libreecho_musb_probe_status: 0 when the probe
+	  was never entered, 1 when it was entered but did not return
+	  success, and 2 when it returned success. A deferred probe or an
+	  error return leaves the value at 1.
+
+	  The pre-userspace LIBREECHO_USERSPACE_WDT_RESET probe selects its
+	  watchdog delay from that value so a fastboot return time identifies
+	  the MUSB probe outcome. The option is off by default and changes no
+	  behavior when disabled.
+
+config LIBREECHO_MUSB_CORE_STATUS
+	bool "Record MUSB controller init status for a boot diagnostic"
+	depends on USB_MUSB_HDRC=y
+	default n
+	help
+	  Temporary LibreEcho diagnostic. The MUSB core records how far
+	  musb_init_controller() got in libreecho_musb_core_status: 0 when it
+	  was never entered, 1 when it was entered but did not return success,
+	  and 2 when it reached the final return 0 after musb_gadget_setup()
+	  and is_initialized. A deferred probe or an error return leaves the
+	  value at 1.
+
+	  When enabled, the pre-userspace LIBREECHO_USERSPACE_WDT_RESET probe
+	  selects its watchdog delay from this core status instead of the
+	  MediaTek glue status, so a fastboot return time identifies whether
+	  the MUSB controller itself initialized. The option is off by default
+	  and changes no behavior when disabled.
+
+config LIBREECHO_MUSB_GADGET_STATUS
+	bool "Record MUSB gadget start and pullup status for a boot diagnostic"
+	depends on USB_MUSB_HDRC=y
+	default n
+	help
+	  Temporary LibreEcho diagnostic. The MUSB gadget records how far
+	  gadget setup got in libreecho_musb_gadget_status: 0 when no gadget
+	  code ran, 1 when musb_gadget_start() was entered but did not
+	  succeed, 2 when musb_gadget_start() returned success, and 3 when
+	  musb_gadget_pullup() was called with is_on set, which is the gadget
+	  driver's request to drive D+.
+
+	  When enabled, the pre-userspace LIBREECHO_USERSPACE_WDT_RESET probe
+	  selects its watchdog delay from this gadget status instead of the
+	  MUSB core or MediaTek glue status. The option is off by default and
+	  changes no behavior when disabled.
+
+config LIBREECHO_MUSB_PULLUP_RESET
+	bool "Reset after the MUSB D+ pullup write for a boot diagnostic"
+	depends on USB_MUSB_HDRC=y && LIBREECHO_LATEINIT_FASTBOOT
+	default n
+	help
+	  Temporary LibreEcho diagnostic. When musb_pullup() is called with
+	  is_on set, after writing MUSB_POWER this reads the register back and
+	  immediately resets the MT8167 through TOPRGU: 5000 ms when the
+	  readback has MUSB_POWER_SOFTCONN set, 10000 ms otherwise. A fastboot
+	  return about 9 s after the reboot therefore proves the actual
+	  hardware pullup write and readback, while about 14 s proves the
+	  write happened but the readback did not retain SOFTCONN.
+
+	  When enabled, the pre-userspace LIBREECHO_USERSPACE_WDT_RESET probe
+	  uses a fixed 15000 ms fallback instead of the gadget, core or glue
+	  status delay. That fallback is reached only when no actual
+	  musb_pullup(is_on) ran, and returns about 19 s after the reboot. The
+	  option is off by default and changes no behavior when disabled.
+
+config LIBREECHO_MUSB_BDEVICE_STATUS
+	bool "Reset after the MUSB D+ pullup write using MUSB_DEVCTL BDEVICE for a boot diagnostic"
+	depends on USB_MUSB_HDRC=y && LIBREECHO_LATEINIT_FASTBOOT
+	default n
+	help
+	  Temporary LibreEcho diagnostic. When musb_pullup() is called with
+	  is_on set, after writing MUSB_POWER this reads MUSB_DEVCTL and
+	  immediately resets the MT8167 through TOPRGU: 5000 ms when the
+	  MUSB_DEVCTL_BDEVICE bit is set (the controller has detected the
+	  host's VBUS as a B-device), otherwise 10000 ms. A fastboot return
+	  about 9 s after the reboot therefore reports BDEVICE set at the
+	  actual pullup write and about 14 s BDEVICE clear.
+
+	  When enabled, the pre-userspace LIBREECHO_USERSPACE_WDT_RESET probe
+	  uses a fixed 15000 ms fallback instead of the status delay. That
+	  fallback is reached only when no actual musb_pullup(is_on) ran and
+	  returns about 19 s after the reboot. The option is off by default
+	  and changes no behavior when disabled.
+
+config LIBREECHO_MUSB_DEVCTL_STATUS
+	bool "Reset after the MUSB D+ pullup write using MUSB_DEVCTL VBUS for a boot diagnostic"
+	depends on USB_MUSB_HDRC=y && LIBREECHO_LATEINIT_FASTBOOT
+	default n
+	help
+	  Temporary LibreEcho diagnostic. When musb_pullup() is called with
+	  is_on set, after writing MUSB_POWER this reads MUSB_DEVCTL and
+	  immediately resets the MT8167 through TOPRGU: 5000 ms when the
+	  MUSB_DEVCTL_VBUS field is full (both bits set), 10000 ms when the
+	  field is nonzero but not full, and 15000 ms when the field is zero.
+	  A fastboot return about 9 s after the reboot therefore reports a
+	  full VBUS indication at the actual pullup write, about 14 s a
+	  partial indication and about 19 s none.
+
+	  When enabled, the pre-userspace LIBREECHO_USERSPACE_WDT_RESET probe
+	  uses a fixed 20000 ms fallback instead of any status delay. That
+	  fallback is reached only when no actual musb_pullup(is_on) ran and
+	  returns about 24 s after the reboot. The option is off by default
+	  and changes no behavior when disabled.
+
 config USB_MUSB_POLARFIRE_SOC
 	tristate "Microchip PolarFire SoC platforms"
 	depends on SOC_MICROCHIP_POLARFIRE || COMPILE_TEST
