diff --git a/arch/arm64/boot/dts/mediatek/libreecho-lidar.dts b/arch/arm64/boot/dts/mediatek/libreecho-lidar.dts
new file mode 100644
index 000000000000..504231ef2a69
--- /dev/null
+++ b/arch/arm64/boot/dts/mediatek/libreecho-lidar.dts
@@ -0,0 +1,236 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * LibreEcho Lidar - Amazon Echo Plus (2nd generation), MediaTek MT8167
+ *
+ * Board facts below come from the production stock device tree (boot_a.bin
+ * appended FDT index 4, "amzn,lidar-pvt", sha256
+ * b5302d9e4a672e7c2d06624d712746fe61fa30ed59183d85f253cec2775a730f) and the
+ * stock kernel boot log.  Values that are inferred from upstream MT8167/
+ * MT8516 support rather than observed in the stock tree are marked.
+ *
+ * Bring-up scope: eMMC, USB, clocks, regulators, 8250 console, ramoops.
+ * Wi-Fi, audio, LEDs and buttons are intentionally absent.
+ */
+
+/dts-v1/;
+
+#include <dt-bindings/pinctrl/mt65xx.h>
+#include "mt8167.dtsi"
+
+/ {
+	model = "LibreEcho Lidar";
+	/*
+	 * The first two entries are the stock PVT identity: LK scores appended
+	 * DTBs against the idme board_id table, so a replacement DTB must keep
+	 * them to be selected on stock firmware.
+	 */
+	compatible = "amzn,lidar-pvt", "amzn,lidar", "mediatek,mt8167";
+
+	aliases {
+		serial0 = &uart0;
+	};
+
+	chosen {
+		/* Console rate matches the stock LK cmdline. */
+		stdout-path = "serial0:921600n8";
+	};
+
+	/*
+	 * The stock tree's memory node says 0x20000000 (512 MiB), but the stock
+	 * boot log reports 259984 pages and a memblock layout running to
+	 * 0x7f9c0000, i.e. 1 GiB of DRAM at 0x40000000.  The firmware fills in
+	 * the real size; 1 GiB is what this board has.
+	 */
+	memory@40000000 {
+		device_type = "memory";
+		reg = <0 0x40000000 0 0x40000000>;
+	};
+
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		/* ATF remains resident and handles PSCI after Linux starts. */
+		atf@43000000 {
+			reg = <0 0x43000000 0 0x30000>;
+			no-map;
+		};
+
+		/*
+		 * LK maps its download window at 0x44fff000..0x4dffffff.
+		 * 0x44400000 is an unmapped hole there, and a probe of the low
+		 * end of the window at 0x45000000 read download-window data
+		 * instead of the marker.  Use the top of the window, where a
+		 * normal download is less likely to overwrite these regions;
+		 * the sizes and the stock ramoops record layout are unchanged.
+		 */
+		ram-console@4df00000 {
+			reg = <0 0x4df00000 0 0x10000>;
+		};
+
+		/*
+		 * Ends exactly at the stock ramdisk load address 0x44000000
+		 * and lies inside LK's boot-image mapping
+		 * (0x40080000..0x4407ffff), unlike the 0x444f0000 hole, so
+		 * LK's fastboot can fetch this page to read the entry
+		 * marker.  no-map keeps the kernel from allocating it.
+		 */
+		entry-probe@43ff0000 {
+			reg = <0 0x43ff0000 0 0x10000>;
+			no-map;
+		};
+
+		minirdump@444f0000 {
+			reg = <0 0x444f0000 0 0x10000>;
+		};
+
+		/*
+		 * Ramoops sits in LK's mapped boot-image window
+		 * (0x40080000..0x4407ffff), clear of the ATF reservation at
+		 * 0x43000000 and the ramdisk load address at 0x44000000.  The
+		 * regions are: records 0x40000, console 0x10000, pmsg
+		 * 0x10000, ending at 0x43870000.  The vendor tree exposed this
+		 * as mediatek,pstore; upstream ramoops needs the standard
+		 * binding.
+		 */
+		ramoops@43810000 {
+			compatible = "ramoops";
+			reg = <0 0x43810000 0 0x60000>;
+			record-size = <0x40000>;
+			console-size = <0x10000>;
+			pmsg-size = <0x10000>;
+			ecc = <0>;
+		};
+	};
+
+	/*
+	 * Stock Lidar has no PMIC-wrapper child device: the pwrap node is
+	 * disabled and eMMC power comes from always-on fixed rails
+	 * (mmc_power 3.3 V, mmc_io 1.8 V in the stock tree).
+	 */
+	reg_3v3: regulator-3v3 {
+		compatible = "regulator-fixed";
+		regulator-name = "mmc_power";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		regulator-always-on;
+	};
+
+	reg_1v8: regulator-1v8 {
+		compatible = "regulator-fixed";
+		regulator-name = "mmc_io";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		regulator-always-on;
+	};
+};
+
+&uart0 {
+	/* Console UART at 0x11005000, as the stock earlycon/cmdline uses. */
+	status = "okay";
+};
+
+&mmc0 {
+	compatible = "mediatek,mt8167-mmc";
+	status = "okay";
+	bus-width = <8>;
+	max-frequency = <200000000>;
+	non-removable;
+	cap-mmc-highspeed;
+	mmc-hs200-1_8v;
+	cap-mmc-hw-reset;
+	vmmc-supply = <&reg_3v3>;
+	vqmmc-supply = <&reg_1v8>;
+	pinctrl-names = "default", "state_uhs";
+	pinctrl-0 = <&mmc0_pins_default>;
+	pinctrl-1 = <&mmc0_pins_uhs>;
+};
+
+/*
+ * MMC0 pad states transcribed from the production PVT device tree:
+ * mmc0default (default) had DAT/CMD pull-up, CLK pull-down and RSTB pull-up
+ * with no drive strength set; the UHS state added 6 mA on DAT/CMD with
+ * R1R0 pull-up 01, 8 mA on CLK with R1R0 pull-down 10, and left RSTB at a
+ * plain pull-up.  Pin numbers and mux 1 match mt8167-pinfunc.h.
+ */
+&pio {
+	mmc0_pins_default: mmc0-pins-default-0 {
+		pins_cmd_dat {
+			pinmux = <MT8167_PIN_120_MSDC0_DAT0__FUNC_MSDC0_DAT0>,
+				 <MT8167_PIN_119_MSDC0_DAT1__FUNC_MSDC0_DAT1>,
+				 <MT8167_PIN_118_MSDC0_DAT2__FUNC_MSDC0_DAT2>,
+				 <MT8167_PIN_117_MSDC0_DAT3__FUNC_MSDC0_DAT3>,
+				 <MT8167_PIN_113_MSDC0_DAT4__FUNC_MSDC0_DAT4>,
+				 <MT8167_PIN_112_MSDC0_DAT5__FUNC_MSDC0_DAT5>,
+				 <MT8167_PIN_111_MSDC0_DAT6__FUNC_MSDC0_DAT6>,
+				 <MT8167_PIN_110_MSDC0_DAT7__FUNC_MSDC0_DAT7>,
+				 <MT8167_PIN_115_MSDC0_CMD__FUNC_MSDC0_CMD>;
+			input-enable;
+			bias-pull-up;
+		};
+
+		pins_clk {
+			pinmux = <MT8167_PIN_116_MSDC0_CLK__FUNC_MSDC0_CLK>;
+			bias-pull-down;
+		};
+
+		pins_rst {
+			pinmux = <MT8167_PIN_114_MSDC0_RSTB__FUNC_MSDC0_RSTB>;
+			bias-pull-up;
+		};
+	};
+
+	mmc0_pins_uhs: mmc0-pins-uhs-1 {
+		pins_cmd_dat {
+			pinmux = <MT8167_PIN_120_MSDC0_DAT0__FUNC_MSDC0_DAT0>,
+				 <MT8167_PIN_119_MSDC0_DAT1__FUNC_MSDC0_DAT1>,
+				 <MT8167_PIN_118_MSDC0_DAT2__FUNC_MSDC0_DAT2>,
+				 <MT8167_PIN_117_MSDC0_DAT3__FUNC_MSDC0_DAT3>,
+				 <MT8167_PIN_113_MSDC0_DAT4__FUNC_MSDC0_DAT4>,
+				 <MT8167_PIN_112_MSDC0_DAT5__FUNC_MSDC0_DAT5>,
+				 <MT8167_PIN_111_MSDC0_DAT6__FUNC_MSDC0_DAT6>,
+				 <MT8167_PIN_110_MSDC0_DAT7__FUNC_MSDC0_DAT7>,
+				 <MT8167_PIN_115_MSDC0_CMD__FUNC_MSDC0_CMD>;
+			input-enable;
+			drive-strength = <MTK_DRIVE_6mA>;
+			bias-pull-up = <MTK_PUPD_SET_R1R0_01>;
+		};
+
+		pins_clk {
+			pinmux = <MT8167_PIN_116_MSDC0_CLK__FUNC_MSDC0_CLK>;
+			drive-strength = <MTK_DRIVE_8mA>;
+			bias-pull-down = <MTK_PUPD_SET_R1R0_10>;
+		};
+
+		pins_rst {
+			pinmux = <MT8167_PIN_114_MSDC0_RSTB__FUNC_MSDC0_RSTB>;
+			bias-pull-up;
+		};
+	};
+};
+
+/*
+ * USB device port on the in-SoC MUSB controller.  Stock uses
+ * "mediatek,mt8167-usb20" with 8-bit FIFOs and OTG; this bring-up keeps the
+ * upstream mtk-musb path and a peripheral role.
+ */
+&usb0 {
+	compatible = "mediatek,mt8167-usb20", "mediatek,mtk-musb";
+	status = "okay";
+	dr_mode = "peripheral";
+};
+
+&usb_phy {
+	status = "okay";
+};
+
+/*
+ * PMIC wrapper support exists for mt8167-pwrap, but the stock tree leaves
+ * pwrap disabled and no MT6357 child was ever described.  Keep it disabled
+ * until a PMIC child is known; regulators above cover this boot chain.
+ */
+&pwrap {
+	compatible = "mediatek,mt8167-pwrap";
+	status = "disabled";
+};
