diff --git a/drivers/misc/libreecho_lateinit_fastboot.c b/drivers/misc/libreecho_lateinit_fastboot.c
new file mode 100644
index 000000000000..90cea851cb0f
--- /dev/null
+++ b/drivers/misc/libreecho_lateinit_fastboot.c
@@ -0,0 +1,118 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Late-init milestone probe that returns the MT8167 to Kaeru fastboot.
+ *
+ * The diagnostic is deliberately destructive: a finite marker is written to
+ * RAM, then the SoC watchdog is armed to reset the CPU without a full power
+ * cycle.  Kaeru re-enumerates over USB, so a fastboot device after the reboot
+ * proves that this late_initcall_sync ran.
+ */
+#include <linux/bits.h>
+#include <linux/delay.h>
+#include <linux/init.h>
+#include <linux/io.h>
+#include <linux/kernel.h>
+#include <linux/processor.h>
+#include <linux/string.h>
+#include <asm/barrier.h>
+#include <asm/cacheflush.h>
+
+#define LIBREECHO_LATEINIT_TAG	"[LIBREECHO-LATEINIT-FASTBOOT]"
+
+#define MT8167_TOPRGU_BASE	0x10007000
+#define TOPRGU_WDT_MODE		0x00
+#define TOPRGU_WDT_RESTART	0x08
+#define TOPRGU_WDT_SWRST	0x14
+#define TOPRGU_WDT_NONRST	0x24
+
+#define WDT_MODE_FASTBOOT_RESET	0x22000014
+#define WDT_RESTART_KEY		0x1971
+#define WDT_SWRST_KEY		0x1209
+#define WDT_NONRST_RST_MODE	BIT(2)
+
+/*
+ * Keep progress markers in the fetched pmsg zone. Standalone words elsewhere
+ * in the boot-image window are overwritten across the watchdog return.
+ */
+#define LIBREECHO_PROGRESS_PHYS	0x43860000
+#define LIBREECHO_LATE_OFFSET	0x100
+
+static const char libreecho_early_marker[] = "EARLY-LIBREECHO!";
+static const char libreecho_lateinit_marker[] = "LIBREECHOLATEINIT!";
+
+/*
+ * Reset the MT8167 through TOPRGU with the bootchain's proven sequence.
+ * delay_ms is the observation window for a probe: LK's fastboot can fetch its
+ * pages while the CPU busy-waits. Zero resets immediately. Never returns.
+ */
+void __noreturn libreecho_wdt_reset(unsigned int delay_ms)
+{
+	void __iomem *toprgu;
+	u32 nonrst;
+
+	if (delay_ms)
+		mdelay(delay_ms);
+
+	toprgu = ioremap(MT8167_TOPRGU_BASE, 0x100);
+	if (!toprgu) {
+		pr_err(LIBREECHO_LATEINIT_TAG " ioremap of TOPRGU failed\n");
+		for (;;)
+			cpu_relax();
+	}
+
+	writel(WDT_RESTART_KEY, toprgu + TOPRGU_WDT_RESTART);
+	nonrst = readl(toprgu + TOPRGU_WDT_NONRST);
+	writel(nonrst | WDT_NONRST_RST_MODE, toprgu + TOPRGU_WDT_NONRST);
+	writel(WDT_MODE_FASTBOOT_RESET, toprgu + TOPRGU_WDT_MODE);
+	dsb(sy);
+	writel(WDT_SWRST_KEY, toprgu + TOPRGU_WDT_SWRST);
+
+	for (;;)
+		cpu_relax();
+}
+
+static int __init libreecho_early_marker_init(void)
+{
+	void *dst = phys_to_virt(LIBREECHO_PROGRESS_PHYS);
+
+	memcpy(dst, libreecho_early_marker, sizeof(libreecho_early_marker));
+	dcache_clean_poc((unsigned long)dst,
+			 (unsigned long)dst + sizeof(libreecho_early_marker));
+	return 0;
+}
+early_initcall(libreecho_early_marker_init);
+
+/*
+ * [LIBREECHO-PROBE] Keep the one-shot late_initcall_sync reset out of the
+ * late level whenever a diagnostic resolves whether that level finished:
+ * an item probe (ITEM >= 0), the after-level reset (INITCALL == 7), or the
+ * userspace exec probe, whose reset must not be masked by an earlier final
+ * late registration. The final registration would otherwise reset inside
+ * the level or before userspace. Remove with the rest of LIBREECHO-PROBE.
+ */
+#if (!defined(CONFIG_LIBREECHO_INITCALL_ITEM_WDT_RESET) || \
+     CONFIG_LIBREECHO_INITCALL_ITEM_WDT_RESET < 0) && \
+    (!defined(CONFIG_LIBREECHO_INITCALL_WDT_RESET) || \
+     CONFIG_LIBREECHO_INITCALL_WDT_RESET != 7) && \
+    !defined(CONFIG_LIBREECHO_USERSPACE_WDT_RESET) && \
+    !defined(CONFIG_LIBREECHO_EXEC_SUCCESS_WDT_RESET)
+static int __init libreecho_lateinit_fastboot_init(void)
+{
+	void *marker;
+
+	pr_info(LIBREECHO_LATEINIT_TAG
+		" late_initcall_sync reached; writing RAM marker and resetting to fastboot\n");
+
+	marker = phys_to_virt(LIBREECHO_PROGRESS_PHYS + LIBREECHO_LATE_OFFSET);
+	memcpy(marker, libreecho_lateinit_marker,
+	       sizeof(libreecho_lateinit_marker));
+	dcache_clean_poc((unsigned long)marker,
+			 (unsigned long)marker +
+			 sizeof(libreecho_lateinit_marker));
+
+	libreecho_wdt_reset(0);
+
+	return 0;
+}
+late_initcall_sync(libreecho_lateinit_fastboot_init);
+#endif
diff --git a/drivers/misc/libreecho_pstore_panic_probe.c b/drivers/misc/libreecho_pstore_panic_probe.c
new file mode 100644
index 000000000000..4466b47b98c8
--- /dev/null
+++ b/drivers/misc/libreecho_pstore_panic_probe.c
@@ -0,0 +1,21 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Forced-panic probe for verifying pstore capture of a late boot crash.
+ *
+ * late_initcall_sync runs after the ordinary late_initcall pstore and
+ * pstore_blk registration, so the panic below exercises the backend exactly
+ * once with the whole boot log already in the ring buffer.
+ */
+#include <linux/init.h>
+#include <linux/kernel.h>
+
+#define LIBREECHO_PSTORE_PROBE_TAG "[LIBREECHO-PSTORE-PROBE]"
+
+static int __init libreecho_pstore_panic_probe_init(void)
+{
+	pr_emerg(LIBREECHO_PSTORE_PROBE_TAG
+		 " late_initcall_sync reached; forcing panic after pstore_blk init\n");
+	panic("LIBREECHO-PSTORE-PROBE forced panic");
+	return 0;
+}
+late_initcall_sync(libreecho_pstore_panic_probe_init);
