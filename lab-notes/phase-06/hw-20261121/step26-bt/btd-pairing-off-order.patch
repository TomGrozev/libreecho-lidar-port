+/*
+ * Restore the settings cached when pairing mode was entered, in an order the
+ * kernel accepts: it rejects MGMT_OP_SET_DISCOVERABLE with MGMT_STATUS_REJECTED
+ * while HCI_CONNECTABLE is clear (net/bluetooth/mgmt.c).  Connectable therefore
+ * comes before discoverable when both are being enabled, and discoverable is
+ * cleared before page scan is turned off.  Bondable is independent of that rule
+ * and is always attempted.
+ */
+static int restore_pairing_settings(struct bt_context *context)
+{
+    int result = 0;
+
+    if (context->pairing_saved_connectable) {
+        result = set_controller_setting(context, MGMT_OP_SET_CONNECTABLE, 1);
+        if (!result)
+            result = set_controller_setting(context, MGMT_OP_SET_DISCOVERABLE,
+                                            context->pairing_saved_discoverable);
+    } else {
+        /*
+         * A refused visibility clear is not reported here: the connectable
+         * restore below turns page scan off, and the kernel treats a not
+         * connectable adapter as not discoverable either way.
+         */
+        (void)set_controller_setting(context, MGMT_OP_SET_DISCOVERABLE, 0);
+        result = set_controller_setting(context, MGMT_OP_SET_CONNECTABLE, 0);
+    }
+    if (set_controller_setting(context, MGMT_OP_SET_BONDABLE,
+                               context->pairing_saved_bondable) != 0 && !result)
+        result = -1;
+    return result;
+}
