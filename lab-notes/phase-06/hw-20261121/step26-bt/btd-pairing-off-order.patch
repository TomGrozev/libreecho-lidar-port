diff --git a/tests/test_bluetooth_pairing_off_contract.sh b/tests/test_bluetooth_pairing_off_contract.sh
new file mode 100755
index 0000000..a2c501f
--- /dev/null
+++ b/tests/test_bluetooth_pairing_off_contract.sh
@@ -0,0 +1,59 @@
+#!/bin/sh
+set -eu
+
+# Regression contract: leaving pairing mode has to work after the controller
+# state drifted, and the cached settings have to be restored in an order the
+# kernel accepts. The kernel rejects MGMT_OP_SET_DISCOVERABLE with
+# MGMT_STATUS_REJECTED while HCI_CONNECTABLE is clear (net/bluetooth/mgmt.c)
+# for either value of the request, so a restore that enables both sets
+# connectable first, and one that disables both clears discoverable first.
+# This source-level check is host-verifiable; the physical pairing remains
+# separate.
+python3 - <<'PY'
+from pathlib import Path
+
+source = Path('src/adapter/btd.c').read_text()
+
+helper = source[source.index('static int restore_pairing_settings('):
+                source.index('static int set_pairing_mode(')]
+assert helper, 'pairing restore helper is missing'
+
+connectable_on = helper.index('MGMT_OP_SET_CONNECTABLE, 1)')
+discoverable_restore = helper.index('MGMT_OP_SET_DISCOVERABLE,', connectable_on)
+assert connectable_on < discoverable_restore, (
+    'the kernel rejects SET_DISCOVERABLE while the adapter is not connectable, '
+    'so the restore must set connectable first'
+)
+discoverable_off = helper.index('MGMT_OP_SET_DISCOVERABLE, 0)',
+                                discoverable_restore)
+connectable_off = helper.index('MGMT_OP_SET_CONNECTABLE, 0)', discoverable_off)
+assert discoverable_off < connectable_off, (
+    'discoverable must be cleared before page scan is turned off'
+)
+
+pairing = source[source.index('static int set_pairing_mode('):
+                 source.index('static int handle_request(')]
+
+# Power already off is not a failure to leave the mode: the userspace mode and
+# its LED are cleared without touching the controller.
+powered = pairing[:pairing.index('if (enabled == context->pairing_mode)')]
+assert 'if (enabled)' in powered
+assert 'context->pairing_mode = 0;' in powered
+assert 'led_pattern("stop"' in powered
+
+# The disable tail must clear the mode and the LED unconditionally, not only
+# when every restore command succeeded. That gate is what left pairing mode on
+# with no way out once the kernel refused the out-of-order restore.
+tail = pairing[pairing.index('result = restore_pairing_settings(context);'):]
+clear = tail.index('context->pairing_mode = 0;')
+assert 'led_pattern("stop", 0, 0, 0, 0, 0);' in tail
+assert 'if (!result) {' not in tail[:clear], (
+    'pairing mode must clear even when a controller restore fails'
+)
+assert clear < tail.index('if (result) {')
+assert pairing.count('restore_pairing_settings(context)') >= 2, (
+    'both the failed-enable rollback and the disable path restore through the '
+    'helper'
+)
+PY
+printf '%s\n' 'bluetooth pairing-off contract: ok'
